{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/ws.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|models/).*)", "destination": "/index.html" }
  ]
}
